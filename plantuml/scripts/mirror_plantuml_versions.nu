# Regenerates ../private/versions.bzl: a mirror of PlantUML release
# checksums, used by extensions.bzl as the default `sha256` for a
# `plantuml.version(...)` tag that doesn't supply one.
#
# Unlike every other mirror script in this repo, Maven Central doesn't
# publish a `.sha256`/`.sha1`/`.asc` file for this artifact at all (verified
# empirically - `plantuml-<version>.jar.sha256` 404s) - so there's no
# checksum or signature to merely fetch. This downloads each version's actual
# jar and hashes it locally instead. PlantUML jars are small (~5MB each) and
# there are only a few hundred versions total, so - unlike the other tools'
# mirrors, which are bounded to a single major line - this mirrors
# PlantUML's entire published history (no version dimension to bound by: it
# doesn't use semver, just an incrementing build number).
#
# Incremental: versions already in the existing file are carried over as-is,
# never re-fetched or re-verified - only releases that aren't in it yet are
# looked up, so a refresh (e.g. the nightly workflow's) is cheap when nothing
# new has shipped.
#
#   cd plantuml && bazel run //scripts:mirror_plantuml_versions

const MAVEN_BASE_URL = "https://repo1.maven.org/maven2/net/sourceforge/plantuml/plantuml"
const USER_AGENT = "bazel-rules-mirror-script"

def list-versions []: nothing -> list<string> {
    http get --raw --headers [User-Agent $USER_AGENT] $"($MAVEN_BASE_URL)/maven-metadata.xml"
    | decode utf-8
    | parse --regex '<version>(?<version>[^<]+)</version>'
    | get version
}

def hash-jar [version: string]: nothing -> any {
    let url = $"($MAVEN_BASE_URL)/($version)/plantuml-($version).jar"
    try {
        http get --raw --headers [User-Agent $USER_AGENT] $url | hash sha256
    } catch {
        print --stderr $"> No jar for PlantUML ($version), skipping"
        null
    }
}

# The versions already mirrored in `versions_file` (its `PLANTUML_VERSIONS = {...}`), if
# it exists - only versions that aren't in it yet are looked up. (Nushell's
# `from json` accepts the trailing commas buildifier, which formats the
# committed file, adds.)
def load-existing [versions_file: string]: nothing -> record {
    if not ($versions_file | path exists) {
        return {}
    }
    let found = (open --raw $versions_file | parse --regex '(?s)PLANTUML_VERSIONS\s*=\s*(?<json>\{.*\})\s*$')
    if ($found | is-empty) {
        error make {msg: $"Could not find PLANTUML_VERSIONS = {...} in existing ($versions_file)"}
    }
    $found.0.json | from json
}

def main [] {
    let workspace = ($env.BUILD_WORKSPACE_DIRECTORY? | default "")
    if $workspace == "" {
        error make {msg: "BUILD_WORKSPACE_DIRECTORY not set, please run via `bazel run ...`"}
    }
    let versions_file = ($workspace | path join private versions.bzl)

    let existing = (load-existing $versions_file)
    print --stderr $"($existing | columns | length) versions already mirrored"

    let versions = (list-versions | where {|v| $v not-in ($existing | columns) })
    print --stderr $"Found ($versions | length) PlantUML release\(s\) not mirrored yet"

    let new_entries = ($versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing PlantUML ($version)..."
        let sha256 = (hash-jar $version)
        if $sha256 == null { $acc } else { $acc | insert $version $sha256 }
    })
    # Newest first, as the release listings are, ahead of what was already there.
    let result = ($new_entries | merge $existing)

    let header = [
        '"""GENERATED by `cd plantuml && bazel run //scripts:mirror_plantuml_versions`.'
        ''
        "A mirror of PlantUML release checksums - Maven Central publishes no"
        "checksum/signature file for this artifact at all, so this was computed by"
        "downloading each version's own jar and hashing it locally (see this"
        "script's own header comment). Used by extensions.bzl as the default"
        "`sha256` for a `plantuml.version(...)` tag that doesn't supply one - an"
        'explicit `sha256` on the tag always overrides this.'
        '"""'
        ''
    ] | str join "\n"
    $"($header)\nPLANTUML_VERSIONS = ($result | to json --indent 2)\n" | save --force $versions_file

    print --stderr $"Wrote ($versions_file)"
}
