# Regenerates ../private/versions.bzl: a GPG-verified mirror of Terraform
# 1.x release checksums, used by extensions.bzl as the default `sha256` for a
# `terraform.version(...)` tag that doesn't supply one for a given platform.
#
# rules_terraform's own build actions/runner all run through rules_nushell's
# hermetic nu rather than bash - this is the same nu, but it still shells out
# to a real `gpg` binary on PATH for signature verification: there's no
# Nushell equivalent to trust for that.
#
#   cd terraform && bazel run //scripts:mirror_terraform_versions

const HASHICORP_RELEASES_BASE_URL = "https://releases.hashicorp.com"
const HASHICORP_PGP_KEY_URL = "https://www.hashicorp.com/.well-known/pgp-key.txt"

def fetch [url: string]: nothing -> binary {
    http get --raw $url | into binary
}

def list-terraform-versions []: nothing -> list<string> {
    # Newest-first, matching the page's own listing order - no explicit sort:
    # reordering would need a version-aware (not lexical) sort anyway, and
    # the page already gives us that for free.
    fetch $"($HASHICORP_RELEASES_BASE_URL)/terraform"
    | decode utf-8
    | parse --regex 'href="/terraform/(?<version>[^"]+)/"'
    | get version
    | where {|v| $v =~ '^1\.[0-9]+\.[0-9]+$' }
}

# Imports HashiCorp's key into `gnupg_home`, returning its (short) key ID.
def import-hashicorp-key [gnupg_home: string]: nothing -> string {
    # Fetched fresh each run rather than hardcoded, so a key rotation doesn't
    # silently break this - see https://www.hashicorp.com/trust/security.
    let key_bytes = (fetch $HASHICORP_PGP_KEY_URL)

    let key_id = ($key_bytes | ^gpg --with-colons --show-keys
        | lines
        | each {|line| $line | split row ":" }
        | where {|fields| $fields.0 == "pub" }
        | get --optional 0.4
    )
    if $key_id == null {
        error make {msg: $"Could not extract a key ID from ($HASHICORP_PGP_KEY_URL)"}
    }

    with-env {GNUPGHOME: $gnupg_home} {
        $key_bytes | ^gpg --quiet --import
    }
    $key_id | str substring (-8)..
}

# Fetches + GPG-verifies `version`'s SHA256SUMS. Returns its content, or null
# if unavailable/unverifiable.
def fetch-verified-sums [version: string, key_id: string, gnupg_home: string]: nothing -> any {
    let base = $"($HASHICORP_RELEASES_BASE_URL)/terraform/($version)/terraform_($version)"
    let fetched = (try {
        {sums: (fetch $"($base)_SHA256SUMS"), sig: (fetch $"($base)_SHA256SUMS.($key_id).sig")}
    } catch {
        null
    })
    if $fetched == null {
        print --stderr $"> No SHA256SUMS for ($version), skipping"
        return null
    }

    let dir = (mktemp --directory)
    let sums_path = ($dir | path join sums)
    let sig_path = ($dir | path join sums.sig)
    $fetched.sums | save --raw $sums_path
    $fetched.sig | save --raw $sig_path
    let result = (with-env {GNUPGHOME: $gnupg_home} {
        ^gpg --verify $sig_path $sums_path | complete
    })
    rm --recursive --force $dir

    if not ($result.stderr | str contains "Good signature") {
        print --stderr $"> Could not verify signature for Terraform ($version), skipping"
        return null
    }
    $fetched.sums | decode utf-8
}

def parse-platform-shas []: string -> record {
    lines
    | where {|line| ($line | str trim) != "" }
    | parse --regex '^(?<sha256>\S+)\s+terraform_[0-9.]+_(?<platform>.+)\.zip$'
    | reduce --fold {} {|row, acc| $acc | upsert $row.platform $row.sha256 }
}

def main [] {
    let workspace = ($env.BUILD_WORKSPACE_DIRECTORY? | default "")
    if $workspace == "" {
        error make {msg: "BUILD_WORKSPACE_DIRECTORY not set, please run via `bazel run ...`"}
    }
    let versions_file = ($workspace | path join private versions.bzl)

    let gnupg_home = (mktemp --directory)
    let key_id = (import-hashicorp-key $gnupg_home)

    let terraform_versions = (list-terraform-versions)
    print --stderr $"Found ($terraform_versions | length) Terraform 1.x releases"

    let result = ($terraform_versions | reduce --fold {} {|version, acc|
        print --stderr $"Processing Terraform ($version)..."
        let sums = (fetch-verified-sums $version $key_id $gnupg_home)
        if $sums == null { $acc } else { $acc | insert $version ($sums | parse-platform-shas) }
    })
    rm --recursive --force $gnupg_home

    let header = [
        '"""GENERATED by `cd terraform && bazel run //scripts:mirror_terraform_versions`.'
        ''
        "A mirror of Terraform 1.x release checksums, fetched from"
        "releases.hashicorp.com and GPG-verified against HashiCorp's published"
        $"signature for each release \(key ($key_id) -"
        "https://www.hashicorp.com/trust/security). Used by `extensions.bzl` as the"
        "default `sha256` for a `terraform.version(...)` tag that doesn't supply one"
        "for a given platform - an explicit `sha256` on the tag always overrides"
        'this.'
        '"""'
        ''
    ] | str join "\n"
    $"($header)\nTERRAFORM_VERSIONS = ($result | to json --indent 2)\n" | save --force $versions_file

    print --stderr $"Wrote ($versions_file)"
}
