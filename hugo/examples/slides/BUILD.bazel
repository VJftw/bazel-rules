load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_hugo//:defs.bzl", "hugo_site")
load("@rules_nushell//:defs.bzl", "nu_test")

# reveal.js's dist/ directory (see MODULE.bazel), at static/reveal/ in this
# site - a directory (tree artifact), so it's served at /reveal/.
copy_to_directory(
    name = "revealjs",
    srcs = ["@revealjs//:dist"],
    out = "static/reveal",
    include_external_repositories = ["*revealjs"],
    root_paths = ["dist"],
)

# `cd slides && bazel run //slides:public_hugo -- server` for a local preview
# (after `bazel build //slides:all`, for the diagrams and reveal.js).
hugo_site(
    name = "public",
    srcs = glob([
        "content/**",
        "layouts/**",
    ]) + [
        ":revealjs",
        "//slides/diagrams",
    ],
    config = "hugo.toml",
)

# Checks the deck has its three slides, with both diagrams and reveal.js.
nu_test(
    name = "public_test",
    src = "public_test.nu",
    data = [":public"],
)
