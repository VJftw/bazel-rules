# Demonstrates templating a Helm chart (//chart:hello) then passing the
# result into kustomize - `rendered.yaml` in kustomization.yaml (in this
# same directory) is what `resources` below makes resolvable at build time.
# The `namespace`/`commonLabels` transforms declared here apply to the
# helm-rendered Deployment too, since it's a first-class `resources:` entry
# of this kustomization, not just a file sitting alongside it.
load("@rules_k8s//:defs.bzl", "kustomize_build")

kustomize_build(
    name = "hello_prod",
    kustomization = "kustomization.yaml",
    resources = {"rendered.yaml": "//chart:hello"},
    visibility = ["//visibility:public"],
)
