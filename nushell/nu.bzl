"""Starlark API for other rulesets that use Nushell internally.

Lets a rule run a Nushell script as a build action (`run_nu`), or make one
its `bazel run`/`bazel test` executable (`nu_launcher`), with the hermetic,
toolchain-resolved `nu` - instead of depending on a shell or on a Python
interpreter for the same job. Such a rule needs `NU_TOOLCHAIN_TYPE` in its
`toolchains`, and (for `nu_launcher`) `NU_LAUNCHER_ATTRS` in its `attrs`.

Its module only needs a `bazel_dep` - rules_nushell requests its own
default Nushell version and registers its toolchains itself (a ruleset may
also declare the `nushell.version` it needs - see extensions.bzl for how
requests combine):

    bazel_dep(name = "rules_nushell", version = "0.1.0")
"""

NU_TOOLCHAIN_TYPE = str(Label("//:toolchain_type"))

_RUNFILES_NU = Label("//runfiles:runfiles.nu")

NU_LAUNCHER_ATTRS = {
    "_nu_runfiles_lib": attr.label(default = _RUNFILES_NU, allow_single_file = True),
    "_nu_windows_constraint": attr.label(default = "@platforms//os:windows"),
}

def nu_bin(ctx):
    """Returns the resolved `nu` executable `File`.

    Args:
      ctx: the rule context. Its rule must list `NU_TOOLCHAIN_TYPE` in `toolchains`.

    Returns:
      The `nu` executable `File`.
    """
    return ctx.toolchains[NU_TOOLCHAIN_TYPE].nushell_info.nu_bin

def rlocation_path(ctx, file):
    """The rlocation-style path `file` will be found at under a target's own runfiles tree at runtime.

    Args:
      ctx: the rule context.
      file: the `File`.

    Returns:
      A "<repo>/<path within that repo>" string, as accepted by `runfiles rlocation`.
    """

    # short_path is repo-relative; files from external repos get a "../repo/"
    # prefix instead of living under the main repo's own workspace name.
    if file.short_path.startswith("../"):
        return file.short_path[len("../"):]
    return ctx.workspace_name + "/" + file.short_path

def run_nu(ctx, script, outputs, arguments = [], inputs = [], tools = [], env = None, mnemonic = None, progress_message = None):
    """Registers a build action that runs `nu --no-config-file <script> <arguments...>`.

    Arguments after the script are passed to its `def main [...]`, e.g.
    `["--out", out.path]` for a `def main [--out: string]`.

    Args:
      ctx: the rule context. Its rule must list `NU_TOOLCHAIN_TYPE` in `toolchains`.
      script: the Nushell script `File` to run.
      outputs: the action's declared outputs.
      arguments: the script's arguments - strings and/or `Args` objects.
      inputs: the action's inputs - a list of `File`s or a depset.
      tools: any other executables the script runs.
      env: the action's environment, as for `ctx.actions.run`.
      mnemonic: the action's mnemonic.
      progress_message: the action's progress message.
    """
    ctx.actions.run(
        outputs = outputs,
        inputs = inputs,
        tools = [script] + tools,
        executable = nu_bin(ctx),
        arguments = ["--no-config-file", script.path] + arguments,
        env = env,
        mnemonic = mnemonic,
        progress_message = progress_message,
    )

_UNIX_LAUNCHER = """\
#!/bin/sh
# Generated by rules_nushell's nu_launcher: runs a Nushell script with the
# hermetic, toolchain-resolved nu, both found via runfiles.

# Without a symlink tree (--enable_runfiles=false), "$0.runfiles" can still
# exist but only hold a MANIFEST - so look for a manifest either way.
if [ -z "${RUNFILES_DIR:-}" ] && [ -z "${RUNFILES_MANIFEST_FILE:-}" ]; then
  if [ -d "$0.runfiles" ]; then
    RUNFILES_DIR="$0.runfiles"
  fi
  if [ -f "$0.runfiles_manifest" ]; then
    RUNFILES_MANIFEST_FILE="$0.runfiles_manifest"
  elif [ -f "$0.runfiles/MANIFEST" ]; then
    RUNFILES_MANIFEST_FILE="$0.runfiles/MANIFEST"
  fi
fi

# Absolute, so they still work after the script changes directory.
case "${RUNFILES_DIR:-}" in ""|/*) ;; *) RUNFILES_DIR="$PWD/$RUNFILES_DIR" ;; esac
case "${RUNFILES_MANIFEST_FILE:-}" in ""|/*) ;; *) RUNFILES_MANIFEST_FILE="$PWD/$RUNFILES_MANIFEST_FILE" ;; esac
[ -n "${RUNFILES_DIR:-}" ] && export RUNFILES_DIR
[ -n "${RUNFILES_MANIFEST_FILE:-}" ] && export RUNFILES_MANIFEST_FILE

rlocation() {
  if [ -n "${RUNFILES_DIR:-}" ] && [ -e "$RUNFILES_DIR/$1" ]; then
    printf '%s\\n' "$RUNFILES_DIR/$1"
    return 0
  fi
  if [ -n "${RUNFILES_MANIFEST_FILE:-}" ]; then
    while IFS= read -r line; do
      case "$line" in
        "$1 "*) printf '%s\\n' "${line#"$1 "}"; return 0 ;;
      esac
    done < "$RUNFILES_MANIFEST_FILE"
  fi
  echo "ERROR: $1 not found in runfiles (run this via bazel run/bazel test)" >&2
  return 1
}

nu=$(rlocation "%{nu}") || exit 1
script=$(rlocation "%{script}") || exit 1
lib=$(rlocation "%{lib}") || exit 1

exec "$nu" --no-config-file --include-path "${lib%/*}" "$script" "$@"
"""

_WINDOWS_LAUNCHER = """\
@echo off\r
rem Generated by rules_nushell's nu_launcher: runs a Nushell script with the\r
rem hermetic, toolchain-resolved nu, both found via runfiles.\r
if not defined RUNFILES_DIR set "RUNFILES_DIR=%~dp0%{name}.runfiles"\r
"%RUNFILES_DIR%\\%{nu}" --no-config-file --include-path "%RUNFILES_DIR%\\%{lib_dir}" "%RUNFILES_DIR%\\%{script}" %*\r
exit /b %ERRORLEVEL%\r
"""

def nu_launcher(ctx, script):
    """Declares an executable that runs `nu --no-config-file <script> <args...>` at runtime.

    For use as a rule's `DefaultInfo.executable`, i.e. for `bazel run`/`bazel
    test`. `nu` and `script` are both found via runfiles, and it propagates
    `nu`'s exit code. A `/bin/sh` script on Linux/macOS, a `.bat` on Windows.

    `RUNFILES_DIR`/`RUNFILES_MANIFEST_FILE` are exported to `script`, and the
    `runfiles.nu` module is on its include path, so `script` can resolve any
    other runfile with `use runfiles.nu` + `runfiles rlocation <path>` (see
    `rlocation_path`). Declare its `def main` with `--wrapped` to receive
    arbitrary arguments (including flags) as-is.

    Args:
      ctx: the rule context. Its rule must list `NU_TOOLCHAIN_TYPE` in
        `toolchains` and include `NU_LAUNCHER_ATTRS` in its `attrs`.
      script: the Nushell script `File` to run.

    Returns:
      struct(executable = File, runfiles = runfiles): the launcher, and the
      runfiles it needs (`nu`, `script` and `runfiles.nu`) - merge these into
      the rule's own.
    """
    nu = nu_bin(ctx)
    lib = ctx.file._nu_runfiles_lib
    is_windows = ctx.target_platform_has_constraint(ctx.attr._nu_windows_constraint[platform_common.ConstraintValueInfo])

    if is_windows:
        executable = ctx.actions.declare_file(ctx.label.name + ".bat")
        lib_rlocation = rlocation_path(ctx, lib)
        content = _WINDOWS_LAUNCHER
        for key, value in {
            "%{name}": executable.basename,
            "%{nu}": rlocation_path(ctx, nu).replace("/", "\\"),
            "%{script}": rlocation_path(ctx, script).replace("/", "\\"),
            "%{lib_dir}": lib_rlocation[:lib_rlocation.rfind("/")].replace("/", "\\"),
        }.items():
            content = content.replace(key, value)
    else:
        executable = ctx.actions.declare_file(ctx.label.name)
        content = _UNIX_LAUNCHER
        for key, value in {
            "%{nu}": rlocation_path(ctx, nu),
            "%{script}": rlocation_path(ctx, script),
            "%{lib}": rlocation_path(ctx, lib),
        }.items():
            content = content.replace(key, value)

    ctx.actions.write(output = executable, content = content, is_executable = True)

    return struct(
        executable = executable,
        runfiles = ctx.runfiles(files = [executable, nu, script, lib]),
    )
