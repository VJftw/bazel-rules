module(
    name = "rules_hugo_examples",
    version = "0.0.0",
)

bazel_dep(name = "rules_hugo", version = "0.1.0")
local_path_override(
    module_name = "rules_hugo",
    path = "..",
)

# rules_hugo's own dependency on rules_nushell (see ../MODULE.bazel) - its
# local_path_override there only applies when rules_hugo is the root module,
# so this (root) module needs its own until rules_nushell is released.
local_path_override(
    module_name = "rules_nushell",
    path = "../../nushell",
)

hugo = use_extension("@rules_hugo//:extensions.bzl", "hugo")
hugo.version(
    sha256 = {
        "darwin_universal": "5ac468a54ccd99bd3bfcdacadec25f6fcd6c0606dccfa86bb761d400d3f0a680",
        "linux_amd64": "0e39b901e3f919f1daae05c8ff64f0c14c8a348ef46886d63f8e6d1bb2653885",
        "linux_arm64": "4b282afd8181e5ed182f50f293fc24dd6c42bfa569e555d53bfbc5ee6a1b2982",
        "windows_amd64": "51e4512ff343e7a2b9d879028a92177d090031c71e7a6a2a3d7cba8536202e80",
    },
    version = "0.166.0",
)
use_repo(hugo, "hugo")

register_toolchains("@hugo//:all")

# The slides example (//slides): its diagrams are rendered with rules_plantuml
# (from this monorepo, like rules_hugo above), and reveal.js is downloaded and
# placed in the site with bazel_lib's copy_to_directory.
bazel_dep(name = "rules_plantuml", version = "0.1.0")
local_path_override(
    module_name = "rules_plantuml",
    path = "../../plantuml",
)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

plantuml = use_extension("@rules_plantuml//:extensions.bzl", "plantuml")
plantuml.version(version = "1.2026.9")
use_repo(plantuml, "plantuml")

register_toolchains("@plantuml//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# reveal.js, from its npm package - only its dist/ directory (the JS, CSS,
# themes and plugins) is used.
http_archive(
    name = "revealjs",
    build_file_content = """filegroup(
    name = "dist",
    srcs = glob(["dist/**"]),
    visibility = ["//visibility:public"],
)
""",
    sha256 = "2f0c20bfb02447a198a1ebe8a8c097a5437d035caa38f2820bf4ba887a3eac91",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/reveal.js/-/reveal.js-6.0.2.tgz",
)
